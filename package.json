{
  "name": "cotuw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:ts && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "levels": "node --no-experimental-webstorage scripts/generate-levels.ts",
    "assets": "node --no-experimental-webstorage scripts/generate-assets.ts",
    "assets:audio": "node --no-experimental-webstorage scripts/generate-audio.ts",
    "assets:terrain": "node --no-experimental-webstorage scripts/generate-terrain.ts",
    "assets:grass": "node --no-experimental-webstorage scripts/generate-grass.ts",
    "assets:effects": "node --no-experimental-webstorage scripts/generate-effects.ts",
    "assets:infantry": "node --no-experimental-webstorage scripts/generate-infantry.ts",
    "assets:models": "node --no-experimental-webstorage scripts/generate-models.ts",
    "format": "npm run format:ts && npm run format:rs",
    "format:ts": "prettier --write .",
    "format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "npm run format:check:ts && npm run format:check:rs",
    "format:check:ts": "prettier --check .",
    "format:check:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint": "npm run lint:ts && npm run lint:rs",
    "lint:ts": "oxlint src tests e2e scripts vite.config.ts vitest.config.ts playwright.config.ts",
    "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "typecheck": "npm run typecheck:ts && npm run typecheck:rs",
    "typecheck:ts": "tsc --noEmit",
    "typecheck:rs": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "test": "npm run test:quick",
    "test:quick": "npm run test:ts:quick && npm run test:visual:quick",
    "test:full": "npm run test:ts && npm run test:rs && npm run test:visual",
    "test:ts": "vitest run",
    "test:ts:quick": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:rs": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "test:visual": "playwright test",
    "test:visual:quick": "playwright test --project=chromium --grep @quick",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:quick",
    "check:full": "npm run format:check && npm run lint && npm run typecheck && npm run test:full"
  },
  "dependencies": {
    "@babylonjs/core": "^9",
    "@babylonjs/loaders": "^9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2"
  },
  "devDependencies": {
    "@babylonjs/serializers": "^9",
    "@playwright/test": "^1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26",
    "@types/pngjs": "^6",
    "oxlint": "^1",
    "pngjs": "^7",
    "prettier": "^3",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^5"
  }
}
